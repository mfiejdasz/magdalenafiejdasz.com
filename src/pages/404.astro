---
import Layout from "../layouts/Layout.astro";
import NotFoundView from "../components/NotFoundView.astro";
import { getDictionary } from "../i18n";

const plTitle = getDictionary("pl").notFound.metaTitle;
const enTitle = getDictionary("en").notFound.metaTitle;
---

<Layout lang="pl" title={plTitle} noindex>
  <div data-view="pl" style="display: contents">
    <NotFoundView lang="pl" />
  </div>
  <template data-view="en" data-title={enTitle}>
    <NotFoundView lang="en" />
  </template>
  <script is:inline src="/404-lang.js"></script>
</Layout>
