---
import Layout from "../layouts/Layout.astro";
import { getDictionary } from "../i18n";

const t = getDictionary("pl").notFound;
---

<Layout lang="pl" noindex>
  <main class="not-found">
    <h1 class="not-found__title">{t.title}</h1>
    <p class="not-found__text">{t.text}</p>
    <a href="/" class="not-found__link">{t.back}</a>
  </main>
</Layout>

<style lang="scss">
  @use "../styles" as *;

  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    text-align: center;
  }

  .not-found__title {
    margin-bottom: 1rem;
    font-size: 2.25rem;
    font-weight: 700;
  }

  .not-found__text {
    margin-bottom: 1rem;
    font-size: 1.25rem;
    color: $muted-foreground;
  }

  .not-found__link {
    color: $primary;
    text-decoration: underline;
  }
</style>
