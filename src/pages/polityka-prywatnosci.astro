---
import Layout from "../layouts/Layout.astro";
import PrivacyPolicy from "../components/PrivacyPolicy.astro";
import { getDictionary, getPrivacyPath } from "../i18n";

const paths = { pl: getPrivacyPath("pl"), en: getPrivacyPath("en") };
---

<Layout lang="pl" title={getDictionary("pl").privacy.metaTitle} paths={paths}>
  <PrivacyPolicy lang="pl" />
</Layout>
