---
import { getDictionary, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).navOpacity;
---

<div class="nav-opacity">
  <label class="nav-opacity__slider">
    <span>{t.label}: <output data-nav-opacity-output>80</output>%</span>
    <input type="range" min="0" max="100" step="1" value="80" data-nav-opacity-input />
  </label>
  <button type="button" data-nav-tone-toggle data-label={t.toneLabel} data-options={JSON.stringify(t.toneOptions)}></button>
</div>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-nav-opacity-input]");
  const output = document.querySelector<HTMLElement>("[data-nav-opacity-output]");
  input?.addEventListener("input", () => {
    document.documentElement.style.setProperty("--nav-alpha", String(Number(input.value) / 100));
    if (output) output.textContent = input.value;
  });

  const toneButton = document.querySelector<HTMLButtonElement>("[data-nav-tone-toggle]");
  if (toneButton) {
    const tones = ["dark", "light"];
    const options: string[] = JSON.parse(toneButton.dataset.options ?? "[]");
    let index = 0;
    const render = () => {
      document.documentElement.dataset.navTone = tones[index];
      toneButton.textContent = `${toneButton.dataset.label}: ${options[index]}`;
    };
    toneButton.addEventListener("click", () => {
      index = (index + 1) % tones.length;
      render();
    });
    render();
  }
</script>

<style lang="scss">
  @use "../styles" as *;

  .nav-opacity {
    position: fixed;
    right: 1rem;
    bottom: 3.75rem;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    font-family: $font-body;
    font-size: 0.8125rem;
    font-weight: 500;
    color: $primary;
    background: with-alpha($card, 0.95);
    border: 1px solid $border;
    border-radius: $radius-sm;
    box-shadow: $shadow-card;
  }

  .nav-opacity__slider {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;

    input {
      width: 12rem;
      accent-color: $primary;
      cursor: pointer;
    }
  }

  .nav-opacity button {
    padding: 0.375rem 0.75rem;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    color: $primary;
    background: $background;
    border: 1px solid $border;
    border-radius: 999px;
    cursor: pointer;
  }
</style>
