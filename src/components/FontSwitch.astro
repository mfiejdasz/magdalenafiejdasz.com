---
import { getDictionary, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).fontSwitch;
---

<button type="button" class="font-switch" data-font-switch data-label={t.label} data-options={JSON.stringify(t.options)}>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-font-switch]");
  const modes = ["current", "uniform"];
  if (button) {
    const options: string[] = JSON.parse(button.dataset.options ?? "[]");
    let index = 0;
    const render = () => {
      document.documentElement.dataset.fonts = modes[index];
      button.textContent = `${button.dataset.label}: ${options[index]}`;
    };
    button.addEventListener("click", () => {
      index = (index + 1) % modes.length;
      render();
    });
    render();
  }
</script>

<style lang="scss">
  @use "../styles" as *;

  .font-switch {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    padding: 0.5rem 0.875rem;
    font-family: $font-body;
    font-size: 0.8125rem;
    font-weight: 500;
    color: $primary;
    background: with-alpha($card, 0.95);
    border: 1px solid $border;
    border-radius: 999px;
    box-shadow: $shadow-card;
    cursor: pointer;
  }
</style>
