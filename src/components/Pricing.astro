---
import { Icon } from "astro-icon/components";
import Button from "./Button.astro";
import SectionHeader from "./SectionHeader.astro";
import { getDictionary, type Lang } from "../i18n";
import { siteConfig } from "../config";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).pricing;
const { street, postalCode, city } = siteConfig.address;
---

<section id="pricing" class="pricing">
  <div class="pricing__container">
    <SectionHeader eyebrow={t.eyebrow} title={t.title} />

    <div class="pricing__content">
      <div class="pricing__list">
        {
          t.items.map((item) => (
            <div class="pricing__row">
              <div>
                <h3 class="pricing__name">{item.name}</h3>
                <div class="pricing__duration">
                  <Icon name="lucide:clock" size={14} />
                  {item.duration}
                </div>
              </div>
              <span class="pricing__price">{item.price}</span>
            </div>
          ))
        }
      </div>

      <div class="pricing__office">
        <div class="pricing__office-icon">
          <Icon name="lucide:map-pin" size={24} />
        </div>
        <div>
          <h3 class="pricing__office-title">{t.officeTitle}</h3>
          <p class="pricing__office-text">{street}, {postalCode} {city} · {t.officeText}</p>
        </div>
      </div>

      <div class="pricing__cta">
        <Button href="#contact" size="lg">{t.cta}</Button>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles" as *;

  .pricing {
    @include section-padding;
    background: with-alpha($secondary, 0.3);
  }

  .pricing__container {
    @include container;
  }

  .pricing__content {
    max-width: 42rem;
    margin-inline: auto;
  }

  .pricing__list {
    overflow: hidden;
    border-radius: $radius-lg;
    background: $card;
    box-shadow: $shadow-card;
  }

  .pricing__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;

    &:not(:last-child) {
      border-bottom: 1px solid $border;
    }

    @include up(lg) {
      padding: 2rem;
    }
  }

  .pricing__name {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.55;
  }

  .pricing__duration {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: $muted-foreground;
  }

  .pricing__price {
    font-family: $font-heading;
    font-size: 1.5rem;
    font-weight: 700;
    color: $primary;
  }

  .pricing__office {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: 2rem;
    border-radius: $radius-lg;
    background: $card;
    box-shadow: $shadow-card;

    @include up(sm) {
      flex-direction: row;
      align-items: center;
    }
  }

  .pricing__office-icon {
    @include icon-box(3rem, $radius-md);
  }

  .pricing__office-title {
    font-weight: 600;
  }

  .pricing__office-text {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: $muted-foreground;
  }

  .pricing__cta {
    margin-top: 2.5rem;
    text-align: center;
  }
</style>
