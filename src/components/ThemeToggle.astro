---
interface Props {
  variant?: "desktop" | "mobile";
}

const { variant = "desktop" } = Astro.props;
---

<button type="button" class:list={["theme-toggle", `theme-toggle--${variant}`]} data-theme-toggle aria-label="Zmień motyw kolorystyczny">
  Pierwszy motyw
</button>

<script>
  import "../scripts/theme-toggle";
</script>

<style lang="scss">
  @use "../styles" as *;

  .theme-toggle {
    padding: 0.25rem 0.5rem;
    border: 1px solid $border;
    border-radius: $radius-sm;
    font-size: 0.75rem;
    font-weight: 500;
    color: $muted-foreground;
    white-space: nowrap;

    @include up(lg) {
      padding: 0.25rem 0.625rem;
      font-size: 0.8125rem;
    }
    transition:
      background 0.2s,
      color 0.2s;

    &:hover {
      background: $hover;
      color: $hover-foreground;
    }
  }

  .theme-toggle--mobile {
    align-self: center;
    margin-top: 0.75rem;
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
  }
</style>
