---
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import { getDictionary, getHomePath, getOtherLang, getPrivacyPath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).privacy;
---

<Navbar lang={lang} onHome={false} switchHref={getPrivacyPath(getOtherLang(lang))} />
<main class="privacy">
  <div class="privacy__container">
    <h1 class="privacy__title">{t.title}</h1>
    {
      t.sections.map((section) => (
        <section class="privacy__section">
          <h2 class="privacy__heading">{section.heading}</h2>
          {section.paragraphs?.map((text) => <p class="privacy__text">{text}</p>)}
          {section.items && (
            <ul class="privacy__list">
              {section.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {section.after?.map((text) => <p class="privacy__text">{text}</p>)}
        </section>
      ))
    }
    <a href={getHomePath(lang)} class="privacy__back">{t.back}</a>
  </div>
</main>
<Footer lang={lang} />

<style lang="scss">
  @use "../styles" as *;

  .privacy {
    padding: calc($navbar-height + 4rem) 1.5rem 5rem;
  }

  .privacy__container {
    margin-inline: auto;
    max-width: 48rem;
  }

  .privacy__title {
    margin-bottom: 1.5rem;
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.25;

    @include up(md) {
      font-size: 2.25rem;
    }
  }

  .privacy__section {
    margin-bottom: 2rem;
  }

  .privacy__heading {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .privacy__text {
    margin-bottom: 0.75rem;
    color: $muted-foreground;
    line-height: 1.7;
  }

  .privacy__list {
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
    list-style: disc;
    color: $muted-foreground;
    line-height: 1.7;
  }

  .privacy__back {
    color: $primary;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
