---
import { Image } from "astro:assets";
import flowersImage from "../assets/2.jpg";
import plumsImage from "../assets/contact-bg.webp";
---

<div class="photo-band" data-photo-band data-state="flowers" aria-hidden="true">
  <Image
    src={flowersImage}
    alt=""
    data-band-image="flowers"
    widths={[960, 1600, 2200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="low"
    decoding="async"
  />
  <Image
    src={plumsImage}
    alt=""
    data-band-image="plums"
    widths={[960, 1600, 2200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="low"
    decoding="async"
  />
</div>

<style lang="scss">
  .photo-band {
    position: relative;
    height: 40vh;
    min-height: 14rem;
    clip-path: inset(0);

    &[data-state="off"] {
      display: none;
    }

    &[data-state="flowers"] :global(img[data-band-image="plums"]),
    &[data-state="plums"] :global(img[data-band-image="flowers"]) {
      display: none;
    }

    :global(.plum-zone:not([data-mode="off"])) & {
      display: none;
    }

    :global(img) {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
