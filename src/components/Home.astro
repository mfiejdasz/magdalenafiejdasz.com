---
import Navbar from "./Navbar.astro";
import Hero from "./Hero.astro";
import About from "./About.astro";
import Services from "./Services.astro";
import PlumZone from "./PlumZone.astro";
import FontSwitch from "./FontSwitch.astro";
import Articles from "./Articles.astro";
import News from "./News.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Navbar lang={lang} />
<main>
  <Hero lang={lang} />
  <PlumZone>
    <About lang={lang} />
    <Services lang={lang} />
    <Articles lang={lang} />
    <News lang={lang} />
    <Contact lang={lang} />
  </PlumZone>
</main>
<Footer lang={lang} />
<FontSwitch lang={lang} />