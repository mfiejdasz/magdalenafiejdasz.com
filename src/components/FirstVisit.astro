---
import { Icon } from "astro-icon/components";
import SectionHeader from "./SectionHeader.astro";
import { getDictionary, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).firstVisit;
const icons = ["lucide:phone", "lucide:message-circle", "lucide:armchair", "lucide:route"];
---

<section id="first-visit" class="first-visit">
  <div class="first-visit__container">
    <SectionHeader eyebrow={t.eyebrow} title={t.title} intro={t.intro} />

    <div class="first-visit__grid">
      {
        t.steps.map((step, index) => (
          <div class="first-visit__step">
            <div class="first-visit__icon">
              <Icon name={icons[index]} size={28} />
            </div>
            <span class="first-visit__number">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="first-visit__title">{step.title}</h3>
            <p class="first-visit__description">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles" as *;

  .first-visit {
    @include section-padding;
    background: $background;
  }

  .first-visit__container {
    @include container;
  }

  .first-visit__grid {
    display: grid;
    gap: 2rem;

    @include up(sm) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @include up(lg) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .first-visit__step {
    position: relative;
    text-align: center;
  }

  .first-visit__icon {
    @include icon-box(4rem, $radius-md);
    margin: 0 auto 1.25rem;
  }

  .first-visit__number {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -0.5rem);
    font-family: $font-body;
    font-size: 0.75rem;
    font-weight: 700;
    color: with-alpha($primary, 0.4);
  }

  .first-visit__title {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.55;
  }

  .first-visit__description {
    font-size: 0.875rem;
    line-height: 1.625;
    color: $muted-foreground;
  }
</style>
