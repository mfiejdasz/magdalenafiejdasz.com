---
interface Props {
  href?: string;
  type?: "button" | "submit";
  variant?: "hero" | "outline";
  size?: "default" | "lg" | "xl";
}

const { href, type = "button", variant = "hero", size = "default" } = Astro.props;
const classes = ["button", `button--${variant}`, `button--${size}`];
---

{
  href ? (
    <a href={href} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes}>
      <slot />
    </button>
  )
}

<style lang="scss">
  @use "../styles" as *;

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    white-space: nowrap;
    border-radius: $radius-md;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s;

    &:focus-visible {
      outline: 2px solid $primary;
      outline-offset: 2px;
    }
  }

  .button--hero {
    background: $primary;
    color: $primary-foreground;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    transition-duration: 0.3s;

    &:hover {
      background: with-alpha($primary, 0.85);
      box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
      transform: translateY(-2px);
    }
  }

  .button--outline {
    border: 1px solid $border;
    background: $background;

    &:hover {
      background: $hover;
      color: $hover-foreground;
    }
  }

  .button--default {
    height: 2.5rem;
    padding: 0.5rem 1.25rem;
  }

  .button--lg {
    height: 3rem;
    padding-inline: 2rem;
    font-size: 1rem;
  }

  .button--xl {
    height: 3.5rem;
    padding-inline: 2.5rem;
    font-size: 1.125rem;
  }
</style>
