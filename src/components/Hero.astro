---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import heroBg from "../assets/hero-orchard2.jpg";
import { getDictionary, type Lang } from "../i18n";
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).hero;
---

<section class="hero" data-hero data-title-size="large" data-mobile-bg="1">
  <div class="hero__bg">
    <Image src={heroBg} alt="" loading="eager" fetchpriority="high" widths={[800, 1280, 1920]} sizes="100vw" />
  </div>
  <div class="hero__overlay"></div>

  <div class="hero__content">
    <div class="hero__inner">
      <p class="hero__eyebrow">{t.eyebrow}</p>
      <h1 class="hero__title">
        <span class="hero__title-line">{t.titleLine}</span>
        <span class="hero__title-line hero__title-line--accent">{t.titleHighlight}</span>
      </h1>
      <div class="hero__text">
        {t.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="hero__actions">
        <Button href="#contact" size="xl">{t.cta}</Button>
        <Button href="#about" variant="outline" size="xl">{t.more}</Button>
      </div>
    </div>
  </div>
  <button type="button" class="hero__title-toggle" data-title-toggle aria-label="Zmień rozmiar nagłówka">
    Nagłówek: duży
  </button>
  <button type="button" class="hero__mobile-toggle" data-mobile-bg-toggle aria-label="Zmień wariant tła na telefonie">
    Wariant tła: 1 / 3
  </button>
</section>

<script>
  const states = [
    { id: "large", label: "Nagłówek: duży" },
    { id: "small", label: "Nagłówek: mniejszy" },
    { id: "hidden", label: "Nagłówek: ukryty" },
  ];

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const button = document.querySelector<HTMLButtonElement>("[data-title-toggle]");

  if (hero && button) {
    let index = 0;
    button.addEventListener("click", () => {
      index = (index + 1) % states.length;
      hero.dataset.titleSize = states[index].id;
      button.textContent = states[index].label;
    });
  }

  const mobileButton = document.querySelector<HTMLButtonElement>("[data-mobile-bg-toggle]");
  const mobileVariants = 3;

  if (hero && mobileButton) {
    let variant = 1;
    mobileButton.addEventListener("click", () => {
      variant = (variant % mobileVariants) + 1;
      hero.dataset.mobileBg = String(variant);
      mobileButton.textContent = `Wariant tła: ${variant} / ${mobileVariants}`;
    });

    new IntersectionObserver(([entry]) => {
      mobileButton.classList.toggle("is-visible", entry.isIntersecting);
    }).observe(hero);
  }
</script>

<style lang="scss">
  @use "sass:color";
  @use "../styles" as *;

  $hero-tint: color.mix($secondary, $background, 60%);

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 90vh;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;

    :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: right center;
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: with-alpha($background, 0.75);
    backdrop-filter: blur(4px);

    @include up(lg) {
      inset: 0 auto 0 0;
      width: calc(max(0px, (100% - 72rem) / 2) + 6rem + 38rem + 8rem);
      background: radial-gradient(
        ellipse 100% 72% at 0% 50%,
        with-alpha($background, 0.9) 0%,
        with-alpha($background, 0.86) 78%,
        with-alpha($background, 0) 100%
      );
      backdrop-filter: none;

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        backdrop-filter: blur(6px);
        mask-image: radial-gradient(ellipse 100% 72% at 0% 50%, black 0%, black 78%, transparent 100%);
      }
    }
  }

  .hero__content {
    @include container;
    @include section-padding;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  @media (max-width: 767px) {
    .hero[data-mobile-bg="1"] {
      --strip-height: 18rem;
      --content-top: 16.5rem;
    }

    .hero[data-mobile-bg="3"] {
      --strip-height: 72vh;
      --content-top: calc(72vh - 7rem);
    }

    .hero[data-mobile-bg="1"],
    .hero[data-mobile-bg="3"] {
      background: $hero-tint;

      .hero__bg {
        inset: 0 0 auto 0;
        height: var(--strip-height);
      }

      .hero__overlay {
        inset: 0 0 auto 0;
        height: var(--strip-height);
        background: linear-gradient(to bottom, with-alpha($hero-tint, 0) 60%, $hero-tint 100%);
        backdrop-filter: none;
      }

      .hero__content {
        padding-top: var(--content-top);
      }
    }
  }

  .hero__mobile-toggle {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 20;
    display: none;
    padding: 0.375rem 0.875rem;
    border: 1px solid $border;
    border-radius: $radius-sm;
    background: $card;
    box-shadow: $shadow-soft;
    font-size: 0.8125rem;
    font-weight: 500;
    color: $muted-foreground;

    &.is-visible {
      display: block;
    }

    @include up(md) {
      &.is-visible {
        display: none;
      }
    }
  }

  .hero__inner {
    max-width: 42rem;
  }

  .hero__eyebrow {
    @include eyebrow;
    margin-bottom: 1rem;
  }

  .hero__title {
    margin-bottom: 1.5rem;
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1.25;

    @include up(md) {
      font-size: 3rem;
    }

    @include up(lg) {
      font-size: 3.75rem;
    }
  }

  .hero[data-title-size="small"] .hero__title {
    font-size: 1.75rem;

    @include up(md) {
      font-size: 2rem;
    }

    @include up(lg) {
      font-size: 2.25rem;
    }
  }

  .hero[data-title-size="hidden"] .hero__title {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero__title-toggle {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    padding: 0.375rem 0.875rem;
    border: 1px solid $border;
    border-radius: $radius-sm;
    background: $card;
    font-size: 0.8125rem;
    font-weight: 500;
    color: $muted-foreground;
    transition:
      background 0.2s,
      color 0.2s;

    &:hover {
      background: $hover;
      color: $hover-foreground;
    }
  }

  .hero__title-line {
    display: block;
    text-wrap: balance;
  }

  .hero__title-line--accent {
    color: $primary;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 38rem;
    margin-bottom: 2.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: $muted-foreground;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;

    @include up(sm) {
      flex-direction: row;
    }
  }
</style>
