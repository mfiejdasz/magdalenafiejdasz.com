---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import heroBg from "../assets/hero-orchard2.jpg";
import { getDictionary, type Lang } from "../i18n";
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).hero;
---

<section class="hero">
  <div class="hero__bg">
    <Image src={heroBg} alt="" loading="eager" fetchpriority="high" widths={[800, 1280, 1920]} sizes="100vw" />
  </div>
  <div class="hero__overlay"></div>

  <div class="hero__content">
    <div class="hero__inner">
      <p class="hero__eyebrow">{t.eyebrow}</p>
      <h1 class="hero__title">
        <span class="hero__title-line">{t.titleLine}</span>
        <span class="hero__title-line hero__title-line--accent">{t.titleHighlight}</span>
      </h1>
      <div class="hero__text">
        {t.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="hero__actions">
        <Button href="#contact" size="xl">{t.cta}</Button>
        <Button href="#about" variant="outline" size="xl">{t.more}</Button>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles" as *;

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 90vh;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;

    :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: with-alpha($background, 0.75);
    backdrop-filter: blur(4px);

    @include up(lg) {
      inset: 0 auto 0 0;
      width: calc(max(0px, (100% - 72rem) / 2) + 6rem + 38rem + 8rem);
      background: radial-gradient(
        ellipse 100% 72% at 0% 50%,
        with-alpha($background, 0.9) 0%,
        with-alpha($background, 0.86) 78%,
        with-alpha($background, 0) 100%
      );
      backdrop-filter: none;

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        backdrop-filter: blur(6px);
        mask-image: radial-gradient(ellipse 100% 72% at 0% 50%, black 0%, black 78%, transparent 100%);
      }
    }
  }

  .hero__content {
    @include container;
    @include section-padding;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero__inner {
    max-width: 42rem;
  }

  .hero__eyebrow {
    @include eyebrow;
    margin-bottom: 1rem;
  }

  .hero__title {
    margin-bottom: 1.5rem;
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1.25;

    @include up(md) {
      font-size: 3rem;
    }

    @include up(lg) {
      font-size: 3.75rem;
    }
  }

  .hero__title-line {
    display: block;
    text-wrap: balance;
  }

  .hero__title-line--accent {
    color: $primary;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 38rem;
    margin-bottom: 2.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: $muted-foreground;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;

    @include up(sm) {
      flex-direction: row;
    }
  }
</style>
