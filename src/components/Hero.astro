---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import heroBg from "../assets/hero-orchard2.jpg";
import { getDictionary, type Lang } from "../i18n";
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).hero;
---

<section class="hero">
  <div class="hero__bg">
    <Image src={heroBg} alt="" loading="eager" fetchpriority="high" widths={[800, 1280, 1920]} sizes="100vw" />
  </div>
  <div class="hero__overlay"></div>

  <div class="hero__content">
    <div class="hero__inner">
      <h1 class="hero__title">{t.title}</h1>
      <div class="hero__text">
        <p>{t.intro} <strong class="hero__emphasis">{t.emphasis}</strong></p>
        <p>{t.closing}</p>
      </div>
      <div class="hero__actions">
        <Button href="#contact" size="xl">{t.cta}</Button>
        <Button href="#about" variant="outline" size="xl">{t.more}</Button>
      </div>
    </div>
  </div>

  <label class="hero__haze-control">
    <span>{t.hazeLabel}: <output data-haze-output>84</output>%</span>
    <input type="range" min="30" max="100" step="1" value="84" data-haze-input />
  </label>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".hero").forEach((hero) => {
    const input = hero.querySelector<HTMLInputElement>("[data-haze-input]");
    const output = hero.querySelector<HTMLElement>("[data-haze-output]");
    input?.addEventListener("input", () => {
      hero.style.setProperty("--haze", String(Number(input.value) / 100));
      if (output) output.textContent = input.value;
    });
  });
</script>

<style lang="scss">
  @use "sass:color";
  @use "../styles" as *;

  $hero-tint: color.mix($secondary, $background, 60%);

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 90vh;
    overflow: hidden;

    @include below(md) {
      --strip-height: 72vh;
      background: $hero-tint;
    }
  }

  .hero__bg {
    position: absolute;
    inset: 0;

    @include below(md) {
      inset: 0 0 auto 0;
      height: var(--strip-height);
    }

    :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: right center;
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: with-alpha($background, 0.75);
    backdrop-filter: blur(4px);

    @include below(md) {
      inset: 0 0 auto 0;
      height: var(--strip-height);
      background: linear-gradient(
        to bottom,
        with-alpha($hero-tint, 0) 45%,
        with-alpha($hero-tint, 0.88) 75%,
        $hero-tint 92%
      );
      backdrop-filter: none;
    }

    @include up(lg) {
      inset: 0 auto 0 0;
      width: calc(max(0px, (100% - 75rem) / 2) + 1.5rem + 38rem + 12rem);
      background: radial-gradient(
        ellipse 100% 72% at 0% 50%,
        #{"hsl(42 60% 95% / var(--haze, 0.84))"} 0%,
        #{"hsl(42 60% 95% / calc(var(--haze, 0.84) * 0.86))"} 85%,
        with-alpha($background, 0) 100%
      );
      backdrop-filter: none;

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        backdrop-filter: blur(6px);
        mask-image: radial-gradient(ellipse 100% 72% at 0% 50%, black 0%, black 85%, transparent 100%);
      }
    }
  }

  .hero__haze-control {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: none;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.625rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: $primary;
    background: with-alpha($card, 0.95);
    border: 1px solid $border;
    border-radius: $radius-sm;
    box-shadow: $shadow-card;

    @include up(lg) {
      display: flex;
    }

    input {
      width: 12rem;
      accent-color: $primary;
      cursor: pointer;
    }
  }

  .hero__content {
    @include container;
    @include section-padding;
    position: relative;
    z-index: 1;
    width: 100%;

    @include below(md) {
      padding-top: calc(var(--strip-height) - 7rem);
    }

    @include up(md) {
      max-width: 75rem;
      padding-inline: 1.5rem;
    }
  }

  .hero__inner {
    max-width: 42rem;
  }

  .hero__title {
    max-width: 38rem;
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    color: $primary;

    @include up(md) {
      font-size: 1.875rem;
    }
  }

  .hero__emphasis {
    font-weight: 600;
    color: $primary;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 38rem;
    margin-bottom: 2.5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: $muted-foreground;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;

    @include up(sm) {
      flex-direction: row;
    }
  }
</style>
