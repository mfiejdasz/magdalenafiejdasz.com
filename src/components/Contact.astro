---
import { Image } from "astro:assets";
import SectionHeader from "./SectionHeader.astro";
import Button from "./Button.astro";
import contactBg from "../assets/contact-bg.jpg";
import { getDictionary, getPrivacyPath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).contact;
---

<section id="contact" class="contact">
  <div class="contact__bg" aria-hidden="true">
    <Image src={contactBg} alt="" widths={[960, 1600, 2200]} sizes="100vw" loading="lazy" />
  </div>
  <div class="contact__overlay"></div>
  <div class="contact__container">
    <SectionHeader title={t.title} />

    <form class="contact__form">
      <div class="contact__field">
        <label for="contact-name">{t.form.name}</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required />
      </div>

      <div class="contact__row">
        <div class="contact__field">
          <label for="contact-email">{t.form.email}</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="contact__field">
          <label for="contact-phone">
            {t.form.phone} <span class="contact__optional">({t.form.optional})</span>
          </label>
          <input id="contact-phone" name="phone" type="tel" autocomplete="tel" />
        </div>
      </div>

      <div class="contact__field">
        <label for="contact-message">{t.form.message}</label>
        <textarea id="contact-message" name="message" rows="6" placeholder={t.form.messagePlaceholder} required
        ></textarea>
      </div>

      <div class="contact__trap" aria-hidden="true">
        <label for="contact-website">Website</label>
        <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <label class="contact__consent">
        <input type="checkbox" name="consent" required />
        <span>
          {t.form.consentBefore}
          <a href={getPrivacyPath(lang)} class="contact__policy" target="_blank" rel="noopener">{t.form.consentLink}</a>.
        </span>
      </label>

      <div class="contact__actions">
        <Button type="submit" size="lg">{t.form.submit}</Button>
      </div>
    </form>
  </div>
</section>

<style lang="scss">
  @use "../styles" as *;

  .contact {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    @include section-padding;
    background: $background;
  }

  .contact__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    clip-path: inset(0);

    :global(img) {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .contact__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: with-alpha($background, 0.55);
    backdrop-filter: blur(2px);
  }

  .contact__container {
    @include container;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-inline: auto;
    max-width: 40rem;
    padding: 2rem;
    border-radius: $radius-lg;
    background: $card;
    box-shadow: $shadow-card;

    @include up(md) {
      padding: 2.5rem;
    }
  }

  .contact__row {
    display: grid;
    gap: 1.5rem;

    @include up(md) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    label {
      font-size: 0.875rem;
      font-weight: 500;
    }

    input,
    textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid $border;
      border-radius: $radius-sm;
      background: $background;
      font: inherit;
      color: $foreground;
      transition:
        border-color 0.2s,
        box-shadow 0.2s;

      &:focus {
        outline: none;
        border-color: $primary;
        box-shadow: 0 0 0 3px with-alpha($primary, 0.2);
      }
    }

    textarea {
      resize: vertical;
      min-height: 9rem;
    }
  }

  .contact__optional {
    font-weight: 400;
    color: $muted-foreground;
  }

  .contact__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact__consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: $muted-foreground;
    cursor: pointer;

    input {
      flex-shrink: 0;
      width: 1.125rem;
      height: 1.125rem;
      margin-top: 0.15rem;
      accent-color: $primary;
    }
  }

  .contact__policy {
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;

    &:hover {
      color: $primary;
    }
  }

  .contact__actions {
    display: flex;
    justify-content: center;
  }
</style>
