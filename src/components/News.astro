---
import { Icon } from "astro-icon/components";
import SectionHeader from "./SectionHeader.astro";
import { getDictionary, type Lang } from "../i18n";
import { events, type EventItem, type EventType } from "../data/events";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).news;

const icons: Record<EventType, string> = {
  retreat: "lucide:waves",
  conference: "lucide:mic",
  workshop: "lucide:users",
  training: "lucide:book-open",
};

const locale = lang === "pl" ? "pl-PL" : "en-GB";
const formatter = new Intl.DateTimeFormat(locale, {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

const toDate = (value: string) => new Date(`${value}T00:00:00Z`);
const endOf = (event: EventItem) => event.endDate ?? event.startDate;

const formatDates = (event: EventItem): string | undefined => {
  if (!event.startDate) return undefined;
  const start = toDate(event.startDate);
  if (!event.endDate || event.endDate === event.startDate) return formatter.format(start);
  return formatter.formatRange(start, toDate(event.endDate));
};

const now = new Date();
const isUpcoming = (event: EventItem) => {
  const end = endOf(event);
  return end ? toDate(end).getTime() + 24 * 60 * 60 * 1000 > now.getTime() : false;
};

const sortKey = (event: EventItem) => (event.startDate ? toDate(event.startDate).getTime() : 0);

const upcoming = events.filter(isUpcoming).sort((a, b) => sortKey(a) - sortKey(b));
const past = events.filter((event) => !isUpcoming(event)).sort((a, b) => sortKey(b) - sortKey(a));

const groups = [
  { title: t.upcomingTitle, items: upcoming, modifier: "upcoming" },
  { title: t.pastTitle, items: past, modifier: "past" },
].filter((group) => group.items.length > 0);
---

<section id="news" class="news">
  <div class="news__container">
    <SectionHeader eyebrow={t.eyebrow} title={t.title} intro={t.intro} />

    <div class="news__groups">
      {
        groups.map((group) => (
          <div class="news__group">
            <h3 class="news__group-title">{group.title}</h3>
            <ul class="news__list">
              {group.items.map((event) => {
                const dates = formatDates(event);
                return (
                  <li class:list={["news__card", `news__card--${group.modifier}`]}>
                    <div class="news__icon">
                      <Icon name={icons[event.type]} size={24} />
                    </div>
                    <div class="news__body">
                      <p class="news__meta">
                        <span class="news__type">{t.types[event.type]}</span>
                        {dates && <span>{dates}</span>}
                        {event.place && (
                          <span class="news__place">
                            <Icon name="lucide:map-pin" size={14} />
                            {event.place[lang]}
                          </span>
                        )}
                      </p>
                      <h4 class="news__title">{event.title[lang]}</h4>
                      {event.description && <p class="news__description">{event.description[lang]}</p>}
                      {event.url && (
                        <a class="news__link" href={event.url} target="_blank" rel="noopener noreferrer">
                          {t.moreInfo}
                          <Icon name="lucide:arrow-up-right" size={16} />
                          <span class="sr-only">{t.openLabel}</span>
                        </a>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles" as *;

  .news {
    @include section-padding;
    background: with-alpha($secondary, 0.3);
  }

  .news__container {
    @include container;
  }

  .news__groups {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-inline: auto;
    max-width: 48rem;
  }

  .news__group-title {
    margin-bottom: 1.5rem;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.33;
  }

  .news__list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .news__card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: $radius-lg;
    background: $card;
    box-shadow: $shadow-card;

    @include up(md) {
      padding: 2rem;
    }
  }

  .news__card--upcoming {
    border: 1px solid with-alpha($primary, 0.35);
  }

  .news__icon {
    @include icon-box(3rem, $radius-md);
  }

  .news__body {
    min-width: 0;
  }

  .news__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    color: $muted-foreground;
  }

  .news__type {
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: $primary;
  }

  .news__place {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .news__title {
    margin-bottom: 0.5rem;
    font-family: $font-heading;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .news__description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: $muted-foreground;
  }

  .news__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: $primary;
    transition: color 0.2s;

    &:hover {
      color: $accent-foreground;
    }
  }
</style>
