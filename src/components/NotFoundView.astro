---
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import { getDictionary, getHomePath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).notFound;
---

<Navbar lang={lang} onHome={false} />
<main class="not-found">
  <h1 class="not-found__title">{t.title}</h1>
  <p class="not-found__text">{t.text}</p>
  <a href={getHomePath(lang)} class="not-found__link">{t.back}</a>
</main>
<Footer lang={lang} />

<style lang="scss">
  @use "../styles" as *;

  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(#{$navbar-height} + 2rem) 1.5rem 4rem;
    text-align: center;
  }

  .not-found__title {
    margin-bottom: 1rem;
    font-size: 2.25rem;
    font-weight: 700;
  }

  .not-found__text {
    margin-bottom: 1rem;
    font-size: 1.25rem;
    color: $muted-foreground;
  }

  .not-found__link {
    color: $primary;
    text-decoration: underline;
  }
</style>
