---
import { getDictionary, type Lang } from "../i18n";
import { siteConfig } from "../config";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang).footer;
---

<footer class="footer">
  <div class="footer__inner">
    <span>© {new Date().getFullYear()} {siteConfig.businessName}. {t.rights}.</span>
    <span>
      {t.credit}
      <a href={siteConfig.author.url} class="footer__link" target="_blank" rel="noopener noreferrer">
        {siteConfig.author.name}
      </a>
    </span>
  </div>
</footer>

<style lang="scss">
  @use "../styles" as *;

  .footer {
    padding: 2rem 1.5rem;
    border-top: 1px solid $border;
  }

  .footer__inner {
    @include container;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.875rem;
    color: $muted-foreground;
    text-align: center;

    @include up(sm) {
      flex-direction: row;
      text-align: left;
    }
  }

  .footer__link {
    transition: color 0.2s;

    &:hover {
      color: $primary;
    }
  }
</style>
