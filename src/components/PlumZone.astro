---
import { Image } from "astro:assets";
import plumsImage from "../assets/contact-bg.webp";
---

<div class="plum-zone">
  <div class="plum-zone__bg" aria-hidden="true">
    <Image
      src={plumsImage}
      alt=""
      widths={[960, 1600, 2200]}
      sizes="100vw"
      loading="eager"
      fetchpriority="low"
      decoding="async"
    />
  </div>
  <div class="plum-zone__veil"></div>
  <slot />
</div>

<style lang="scss">
  @use "../styles" as *;

  .plum-zone {
    position: relative;
    isolation: isolate;
  }

  .plum-zone__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    clip-path: inset(0);

    :global(img) {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .plum-zone__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: with-alpha($background, 0.8);
    backdrop-filter: blur(3px);
  }
</style>
